c-control/"}],"tr":"","im":"","arch":{"l":[],"n":0,"since":null,"terms":["자율주행","FPV 드론"]}},{"i":5,"icon":"money","title":"방산 제조·시장","sub":"해외 계약·제조기반 동향","points":["인도, Barak 1 노후화 관리 계약 약 2.1억$","하와이 조선·제조 훈련, IBAS 700만$","해양자재 시장, 해군·해상풍력 견인"],"items":[{"no":24,"id":"f671cdd817b3","h":"인도 Barak 1 업그레이드","d":"약 2.1억 달러 업그레이드·노후화 관리 계약","s":"인도 국방부가 11월 18일 IAI와 인도 해군 Barak 점방어 미사일 체계의 업그레이드 및 노후화 관리 계약을 체결했다. 규모는 INR19.76 billion(약 US$210 million)이다.","src":"Asian Military Review","date":"2026-11-23","url":"https://www.asianmilitaryreview.com/2026/11/indian-navy-to-upgrade-barak-1-point-defence-missile-systems-foc/"},{"no":25,"id":"4d491a474fb3","h":"하와이 조선·제조 역량 프로그램","d":"훈련사업, IBAS 700만 달러 투자","s":"하와이에서 조선 및 방위산업 제조 역량을 키우는 프로그램이 추진된다. 한 훈련 사업은 국방부 산업기반분석·유지(IBAS) 프로그램에서 700만 달러를 투자받았다.","src":"Defense One","date":"2026-11-25","url":"https://www.defenseone.com/business/2026/11/program-looks-build-shipbuilding-defense-manufacturing-capability-hawaii/417440/"},{"no":26,"id":"faa5b6fb31a7","h":"해양 자재·구조 부품 2035 전망","d":"해군·해상풍력 수요 견인, 세부 수치 미확인","s":"IndexBox 기사로, 해군 및 해상풍력 수요가 해양용 자재·구조 부품 시장을 이끄는 흐름을 2035년까지 전망한다. 발췌가 없어 세부 수치는 확인되지 않는다.","src":"IndexBox","date":"2026-11-23","url":"https://news.google.?oc=5"},{"no":27,"id":"f067d847525f","h":"미래차 피지컬 AI·부품 생태계","d":"미래차 주도권, 부품 생태계 확장에 달림","s":"미래차 주도권은 피지컬 AI와 부품 생태계 확장에 달렸다는 취지의 기고문이다.","src":"전자신문","date":"2026-11-24","url":"https://news.google.com/rss/articles/CBMiTkFVX3lxTFByN1ZBYi1Kd3h1QnhRV2J3YkpoLVd6NUk4TWlvSnI1RGhuSlVpLU5ERlBjZkYxYkxlM3lodm5GRlhpVEJvZmdfeHNlbkcwQQ?oc=5"}],"tr":"","im":"","arch":{"l":[],"n":0,"since":null,"terms":[]}}],"imps":[{"t":"가동률 선행관리","d":"가동률 41.9% 사례처럼 지표 상시 관리 필요"},{"t":"인력 리스크 예측","d":"인력 부족·노사 분쟁을 정비인력 예측 변수로"},{"t":"수리부속 공급망","d":"국산화·동맹 공급망 협력을 수리부속 예측에 반영"},{"t":"통합정보체계 연계","d":"드론 표준화·MRO 데이터를 체계에 연계"}],"recs":[{"t":"MRO 정보 연계","d":"국제 MRO 협력 대비 군수정보 연계 기준 검토"},{"t":"가동률 예측 고도화","d":"가동 가능 비율 지표 기반 신뢰도 예측 모델 점검"},{"t":"수리부속 국산화 연계","d":"국산화 품목의 수리부속·정비인력 수요 예측 연계"}],"flow":{"ov":"이번 주는 창원 국제 해군 군수·MRO 포럼을 계기로 함정 MRO 국제협력, 부품 국산화, 수출 연계가 전면에 나왔다. 지난주의 지속지원·공급망 보안 논의는 동맹 간 지속지원 협의와 각국 준비태세 점검으로 이어졌고, 육군 드론 MRO·표준화 소식이 더해졌다.","flows":[{"t":"함정 MRO·국산화 부상","d":"14개국 700명이 창원 포럼에 참가했고, 경남도는 부품 국산화 교류회와 MRO 보안 지원기관 선정 등을 추진했다.","dir":"신규"},{"t":"동맹·연합 지속지원","d":"미 육군 첫 연합 지속지원 회의와 DLA의 감사·공급망 현대화 행보 등 협력 중심의 지원체계 논의가 이어졌다.","dir":"확대"},{"t":"준비태세 리스크 부각","d":"캐나다 공군 가동 한계, 영국 투자계획의 준비태세 삭감, 영 해군 잠수함 노사분규 등 준비태세 우려가 보고됐다.","dir":"지속"}],"tech":[{"id":"T-CY-69-1","why":"DLA 공급망 현대화와 경남TP 함정 MRO 보안 기관 선정이 맞닿음","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-1 공급망 보안 기술: 무기체계 개발과 운용에 사용되는 하드웨어, 소프트웨어, 펌웨어 등 모든 구성요소의 개발 및 유통 과정에서 발생할 수 있는 보안 위협을 식별⸱분석⸱완화⸱검증하는 기"},{"id":"T-CY-69-3","why":"함정 MRO 보안 지원 논의가 무기체계 사이버위험 관리와 연계됨","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-3 K-RMF 검증 기술: 무기체계 및 방산 정보체계의 생명주기에 따른 사이버위험 관리를 위하여 보안등급 선정⸱통제항목, 선정⸱개발계획, 수립⸱평가의 각 단계를 지원 및 검증하기 위한 기술"},{"id":"T-AI-6-3","why":"가동률·준비태세 강조와 육군 소프트웨어 준비태세 기사가 정비지원 고도화와 연계됨","desc":"[국방기술기획서·인공지능] 지능형 군수지원 > 6-3 AI 기반 정비 군수지원 기술: 전장의 지휘관에게 데이터에 기반한 최적의 정비 군수지원 방안을 실시간으로 제안하는 기술. 전투 상황, 부대 위치, 재고 현황, 보급로 상태, 적 위협 등 파편화된"}],"tasks":[{"id":"K-395","why":"육군 25㎏ 이하 드론 표준 플랫폼, 제5군수지원여단 드론 교육·MRO 협력과 연계","desc":"[국방기술 과제 395·미래도전국방기술] 피지컬 AI 기술 기반 다목적 군집드론 통합운용 시스템 개발 (2026-2028(36개월), 495.00억원, 국과연): 복합 전장 환경에서 이기종 군집 드론 간 공유되는 상태정보를 활용하여 감시정찰, 타격 등의 지능형 임무 수행이 가능하고, AI 기반 전장 상황 "}]},"cmp":{"prev":"2026-W47","prev_label":"2026년 47주차(11.16~11.22)","n":46,"pn":107,"d":-61,"pct":-57,"regions":[{"k":"us","now":27,"prev":68,"d":-41},{"k":"kr","now":15,"prev":33,"d":-18},{"k":"etc","now":2,"prev":0,"d":2},{"k":"eu","now":2,"prev":6,"d":-4}],"domains":[{"k":"wpn","now":30,"prev":80,"d":-50},{"k":"fcst","now":11,"prev":10,"d":1},{"k":"lis","now":5,"prev":13,"d":-8}],"kinds":[{"k":"news","now":24,"prev":33,"d":-9},{"k":"contract","now":21,"prev":72,"d":-51},{"k":"policy","now":1,"prev":2,"d":-1}],"new_kw":["단종관리"],"up_kw":[["유무인 복합",2],["신뢰도·가용도",2],["국산화",2]],"down_kw":[["가동률·준비태세",10],["창정비",7