HNlbkcwQQ?oc=5"}],"tr":"","im":"","arch":{"l":[],"n":0,"since":null,"terms":[]}}],"imps":[{"t":"MRO 협력 선점","d":"14개국 포럼 계기 MRO 협력·정보 연계 검토"},{"t":"가동률 선제관리","d":"노후·인력 요인 가동률 선제 관리"},{"t":"수리부속 예측 고도화","d":"국산화 확대 대비 수리부속 수급 예측 반영"},{"t":"드론 정비 대비","d":"드론 대량 도입 대비 정비인력·신뢰도 모델 확장"}],"recs":[{"t":"가동률 상시관리","d":"캐나다 41.9% 사례 참고, 신뢰도 예측과 연계"},{"t":"수리부속 국산화 연계","d":"국산화 품목 정보를 수리부속 예측에 반영"},{"t":"정비인력 리스크 예측","d":"인력 부족·노사분쟁 사례를 인력 예측에 반영"}],"flow":{"ov":"이번 주는 창원 국제 해군 군수·MRO 포럼을 중심으로 함정 MRO·부품 국산화·보안 논의가 크게 부각됐다. 지난주 지속지원·가동률 논의에서 한 걸음 나아가, 다국적 협력과 지자체·민간 참여, 야전 드론 정비 협력이 구체화됐다.","flows":[{"t":"함정 MRO 국제협력","d":"14개국 700명이 창원 포럼에 참가해 K-함정 수출과 MRO 시장 연계를 논의했다.","dir":"신규"},{"t":"민관군 부품 국산화","d":"경남도·해군 교류회와 방산 투자, 경남TP 함정 MRO 보안기관 선정이 이어졌다.","dir":"확대"},{"t":"가동률·동맹 지속지원","d":"미 육군 동맹 지속지원 회의, 영국 잠수함·캐나다 공군 가동률 문제가 부각됐다.","dir":"지속"}],"tech":[{"id":"T-AI-6-3","why":"가동률·재고·정비 쟁점이 반복돼 데이터 기반 정비 군수지원 기술과 연결","desc":"[국방기술기획서·인공지능] 지능형 군수지원 > 6-3 AI 기반 정비 군수지원 기술: 전장의 지휘관에게 데이터에 기반한 최적의 정비 군수지원 방안을 실시간으로 제안하는 기술. 전투 상황, 부대 위치, 재고 현황, 보급로 상태, 적 위협 등 파편화된"},{"id":"T-CY-69-3","why":"함정 MRO 보안 지원기관 선정으로 무기체계 사이버보안 검증 필요성 부각","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-3 K-RMF 검증 기술: 무기체계 및 방산 정보체계의 생명주기에 따른 사이버위험 관리를 위하여 보안등급 선정⸱통제항목, 선정⸱개발계획, 수립⸱평가의 각 단계를 지원 및 검증하기 위한 기술"}],"tasks":[{"id":"K-395","why":"육군 25kg 이하 드론 표준 플랫폼, 제5군수지원여단 드론·MRO 협약과 연계","desc":"[국방기술 과제 395·미래도전국방기술] 피지컬 AI 기술 기반 다목적 군집드론 통합운용 시스템 개발 (2026-2028(36개월), 495.00억원, 국과연): 복합 전장 환경에서 이기종 군집 드론 간 공유되는 상태정보를 활용하여 감시정찰, 타격 등의 지능형 임무 수행이 가능하고, AI 기반 전장 상황 "},{"id":"K-31","why":"잠수함 가동률 이슈와 함정 MRO·부품 국산화 논의에 시사점","desc":"[국방기술 과제 31·기초연구] 잠수함 첨단함형 특화연구실 (2023-2029(64개월), 50.00억원, 산학연): 국내개발 잠수함의 미래 핵심기술을 개발하고 주요 핵심기술/신기술의 연구기반 확보를 위 한 선행연구 수행 및 부가물/함형 개선방안 분석을 통한 기"}]},"cmp":{"prev":"2026-W47","prev_label":"2026년 47주차(11.16~11.22)","n":39,"pn":107,"d":-68,"pct":-64,"regions":[{"k":"us","now":21,"prev":68,"d":-47},{"k":"kr","now":15,"prev":33,"d":-18},{"k":"etc","now":2,"prev":0,"d":2},{"k":"eu","now":1,"pr