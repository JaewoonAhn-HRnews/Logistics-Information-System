이번 주는 미 GAO·IG의 탄약·F-35 부품 데이터 관리 지적과 함께 AI 기반 통합 군수 플랫폼, 민·군 MRO 협력 수주가 이어졌다. 지난주 F-35 부품 추적·재고 데이터 신뢰 쟁점이 탄약 계획·데이터 관리로 넓어졌고, 국내는 K-MRO 거점화로 확장됐다.","flows":[{"t":"군수 데이터 관리 쟁점 확대","d":"GAO가 탄약 부족 대응 계획과 데이터 관리를 촉구하고 F-35 부품 사각지대 우려도 이어짐","dir":"확대"},{"t":"AI 기반 군수·준비태세","d":"KAI 통합 군수 플랫폼, Virtualitics 탄약 준비태세 AI 계약 등 AI 군수 도입 가시화","dir":"신규"},{"t":"민·군 MRO 협력 거점화","d":"HD현대중 미 함정 MRO 4번째 수주, LIG D&A·한화에어로의 공군·육군 정비 협력","dir":"확대"}],"tech":[{"id":"T-AI-6-3","why":"KAI AI 통합 군수 플랫폼, 탄약 준비태세 AI 계약과 직접 연계","desc":"[국방기술기획서·인공지능] 지능형 군수지원 > 6-3 AI 기반 정비 군수지원 기술: 전장의 지휘관에게 데이터에 기반한 최적의 정비 군수지원 방안을 실시간으로 제안하는 기술. 전투 상황, 부대 위치, 재고 현황, 보급로 상태, 적 위협 등 파편화된"},{"id":"T-CY-69-1","why":"NATO 무기 백도어 경고, SW 공급망 보안 플랫폼 공개와 연계","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-1 공급망 보안 기술: 무기체계 개발과 운용에 사용되는 하드웨어, 소프트웨어, 펌웨어 등 모든 구성요소의 개발 및 유통 과정에서 발생할 수 있는 보안 위협을 식별⸱분석⸱완화⸱검증하는 기"},{"id":"T-AI-6-1","why":"무기 가동률 제고, 항공 전력 준비태세 저하 논의와 연계","desc":"[국방기술기획서·인공지능] 지능형 군수지원 > 6-1 예지정비(PHM, CBM+) 기술: 무기체계나 핵심 장비에 부착된 센서로 상태 데이터를 실시간 수집하고, AI가 이를 분석하여 부품의 수명과 고장 징후를 사전에 예측하는 기술"}],"tasks":[]},"cmp":{"prev":"2026-W46","prev_label":"2026년 46주차(11.9~11.15)","n":102,"pn":116,"d":-14,"pct":-12,"regions":[{"k":"us","now":67,"prev":64,"d":3},{"k":"kr","now":30,"prev":43,"d":-13},{"k":"eu","now":5,"prev":4,"d":1},{"k":"etc","now":0,"prev":5,"d":-5}],"domains":[{"k":"wpn","now":77,"prev":87,"d":-10},{"k":"lis","now":12,"prev":13,"d":-1},{"k":"fcst","now":10,"prev":16,"d":-6}],"kinds":[{"k":"contract","now":68,"prev":62,"d":6},{"k":"news","now":32,"prev":45,"d":-13},{"k":"policy","now":2,"prev":9,"d":-7}],"new_kw":["자율주행 보급","국산화","수요예측"],"up_kw":[["공급망",5]],"down_kw":[["MRO",4],["가동률·준비태세",3],["정비인력",3]],"themes":[{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null}]},"n":25,"total":40,"at":"2026-11-21 11:49","final":false,"created":"2026-11-17 03:58","updated":"2026-11-21 11:51"}
