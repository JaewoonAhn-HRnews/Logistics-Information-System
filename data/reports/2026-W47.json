a2db484","h":"영국 호위함 미국 도입 주장","d":"영국 국방준비태세·산업 장관 기고","s":"영국 국방준비태세·산업 장관이 기고문에서 미국이 영국의 호위함 설계를 도입해 미국 내에서 생산해야 한다고 주장했다.","src":"Breaking Defense","date":"2026-11-19","url":"https://breakingdefense.com/2026/11/britain-has-the-frigate-the-us-needs-and-americans-should-build-it-uk-minister/"}],"tr":"","im":"","arch":{"l":[],"n":0,"since":null,"terms":[]}}],"imps":[{"t":"신뢰도 예측 보강","d":"가동률 하락 사례를 신뢰도 예측 지표에 반영"},{"t":"수리부속 수급 점검","d":"탄약·반도체 공급 불안 대비 부속 수요 재점검"},{"t":"정비인력·연계 설계","d":"민간 정비거점 확대를 인력예측·정보연계에 반영"}],"recs":[{"t":"신뢰도 예측 보강","d":"가동률 하락 사례를 신뢰도 예측 지표에 반영"},{"t":"수리부속 수급 점검","d":"탄약·반도체 공급 불안 대비 부속 수요 재점검"},{"t":"정비인력·연계 설계","d":"민간 정비거점 확대를 인력예측·정보연계에 반영"}],"flow":{"ov":"이번 주는 민·군 MRO 협력 확대, 미 육군·F-35 중심의 군수 유지·계약 이어짐, 탄약 부족과 즉응태세 저하 경고가 두드러졌다. 지난주 F-35 부품 추적 등 데이터 신뢰성 논의에서, 공급망 보안(백도어, SW 공급망)과 수출통제 리스크로 초점이 확장됐다.","flows":[{"t":"민·군 MRO 거점 확대","d":"LIG D&A·한화에어로가 공군·육군과 MRO 협력과 정비센터 확충을 추진","dir":"확대"},{"t":"유지계약·즉응태세 압박","d":"F-35·스트라이커 유지계약 이어지고 GAO·IG는 탄약 부족과 즉응태세 저하 지적","dir":"지속"},{"t":"공급망 보안·통제 이슈","d":"NATO 무기 백도어 경고, SW 공급망 보안 플랫폼, 전력반도체 수출통제 부각","dir":"전환"}],"tech":[{"id":"T-CY-69-1","why":"NATO 백도어 경고와 SW 공급망 보안 플랫폼 공개와 직결","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-1 공급망 보안 기술: 무기체계 개발과 운용에 사용되는 하드웨어, 소프트웨어, 펌웨어 등 모든 구성요소의 개발 및 유통 과정에서 발생할 수 있는 보안 위협을 식별⸱분석⸱완화⸱검증하는 기"},{"id":"T-AI-6-3","why":"육군 군수 현대화·정비 지원 논의와 AI 정비 군수지원 연계","desc":"[국방기술기획서·인공지능] 지능형 군수지원 > 6-3 AI 기반 정비 군수지원 기술: 전장의 지휘관에게 데이터에 기반한 최적의 정비 군수지원 방안을 실시간으로 제안하는 기술. 전투 상황, 부대 위치, 재고 현황, 보급로 상태, 적 위협 등 파편화된"},{"id":"T-MAT-50-1","why":"전력반도체 공급망 수출통제 및 국산화 필요성과 연계","desc":"[국방기술기획서·첨단소재] 고출력 고효율 전력 반도체 소재 > 50-1 SiC반도체: 차세대 전력 반도체로서 고전압 고온 고주파 환경에서 안정적임. 밴드갭이 넓으며 항복전계가 높고 고속 스위칭 특성을 보유한 반도체 기술"}],"tasks":[]},"n":25,"total":31,"at":"2026-11-20 11:35","final":false,"created":"2026-11-17 03:58","updated":"2026-11-20 11:38"}
