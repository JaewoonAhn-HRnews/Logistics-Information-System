하여 부품의 수명과 고장 징후를 사전에 예측하는 기술"}],"tasks":[]},"cmp":{"prev":"2026-W46","prev_label":"2026년 46주차(11.9~11.15)","n":93,"pn":116,"d":-23,"pct":-20,"regions":[{"k":"us","now":60,"prev":64,"d":-4},{"k":"kr","now":28,"prev":43,"d":-15},{"k":"eu","now":5,"prev":4,"d":1},{"k":"etc","now":0,"prev":5,"d":-5}],"domains":[{"k":"wpn","now":70,"prev":87,"d":-17},{"k":"lis","now":10,"prev":13,"d":-3},{"k":"fcst","now":8,"prev":16,"d":-8}],"kinds":[{"k":"contract","now":61,"prev":62,"d":-1},{"k":"news","now":31,"prev":45,"d":-14},{"k":"policy","now":1,"prev":9,"d":-8}],"new_kw":["자율주행 보급","국산화","수요예측"],"up_kw":[["공급망",5]],"down_kw":[["가동률·준비태세",5],["MRO",5],["AI",3],["정비인력",3]],"themes":[{"streak":2,"prev":"한화·육군 K-MRO"},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null},{"streak":1,"prev":null}]},"n":21,"total":39,"at":"2026-11-21 02:19","final":false,"created":"2026-11-17 03:58","updated":"2026-11-21 02:20"}
