,{"i":5,"icon":"robot","title":"산업협력·AI 드론","sub":"육군 현대화와 드론 보안 개발","points":["AUSA, 산업계 협력으로 현대화","새솔테크 국방벤처 지원사업 선정","AI 드론 보안 플랫폼 개발"],"items":[{"no":14,"id":"15e3fdb3b41c","h":"새솔테크, AI 드론 보안 개발","d":"국방벤처 지원사업 선정, 플랫폼 개발","s":"새솔테크가 '국방벤처 지원사업'에 선정되어 AI 드론 보안 플랫폼을 개발한다. 머니투데이가 보도했다.","src":"머니투데이","date":"2026-11-16","url":"https://news.google.?oc=5"},{"no":15,"id":"f6b87221a626","h":"AUSA 2026 산업협력 강조","d":"산업계 협력, 육군 현대화·준비태세 기여","s":"AUSA 2026 행사에서 산업계와의 협력이 미 육군의 현대화와 병사 준비태세를 발전시킨다는 내용이다.","src":"Army.mil","date":"2026-11-17","url":"https://news.google.?oc=5"}],"tr":"","im":"","arch":{"l":[],"n":0,"since":null,"terms":["AUSA 2026","AI 드론"]}}],"imps":[{"t":"가동률 선행지표","d":"FMC 하락·사고 증가 추세를 신뢰도 예측에 반영"},{"t":"민·군 정비 연계","d":"민·군 MRO 정보를 통합정보체계와 연계 검토"},{"t":"정비인력 수요 예측","d":"신규 정비센터·거점 확대에 따른 인력 수요 반영"},{"t":"수리부속·SW 보안","d":"지원 부담 시 재고, SW 공급망 위험 함께 점검"}],"recs":[{"t":"정비거점 연계","d":"민·군 정비거점 실적을 군수정보체계에 통합"},{"t":"가동률 예측 고도화","d":"FMC 하락 추세를 신뢰도·수리부속 예측에 반영"},{"t":"SW 공급망 보안","d":"체계 연계 SW의 공급망 전 단계 보안 점검"}],"flow":{"ov":"이번 주는 한국 방산기업과 공군·육군의 MRO 협력·거점화가 이어지는 가운데, 미 육군의 가동률 저하와 우크라이나 지원에 따른 즉응태세 부담, NATO의 무기 백도어 경고가 함께 부각됐다. 지난주 F-35 부품 추적 실패로 본 군수데이터 신뢰성 문제가 이번 주에는 공급망·SW 보안 문제로 넓어졌다.","flows":[{"t":"민·군 MRO 협력 확대","d":"LIG D&A-공군, 한화에어로-육군 동부 정비센터 등 민간 정비 거점화와 협력이 이어짐","dir":"확대"},{"t":"즉응태세 압박 부각","d":"미 육군 항공 사고 증가·가동률 하락, 유럽 내 우크라이나 지원 부담이 readiness 문제로 지적됨","dir":"신규"},{"t":"공급망·SW 보안 전환","d":"NATO의 무기 내 백도어 경고와 AI 기반 SW 공급망 보안 플랫폼 공개로 보안 논의가 확산됨","dir":"전환"}],"tech":[{"id":"T-CY-69-1","why":"NATO 백도어 경고, SW 공급망 보안 플랫폼 공개와 직결","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-1 공급망 보안 기술: 무기체계 개발과 운용에 사용되는 하드웨어, 소프트웨어, 펌웨어 등 모든 구성요소의 개발 및 유통 과정에서 발생할 수 있는 보안 위협을 식별⸱분석⸱완화⸱검증하는 기"},{"id":"T-AI-8-3","why":"지난주 부품 추적 오류에 이은 군수데이터 신뢰성·보안 사안과 연관","desc":"[국방기술기획서·인공지능] 데이터 수집/저장/관리 > 8-3 데이터 보안 기술: 국방 데이터의 보안 등급 및 인증, 역할 기반 접근 제어(RBAC), 데이터의 변조·위조, 데이터 오염(data poisoning) 등을 자동 탐지 등을 통해 검"},{"id":"F-6-2","why":"AI 드론 보안 플랫폼 개발 지원 선정 기사와 연계","desc":"[전력지원체계 주요기술·항공장비(드론)] 공통 플랫폼 기술: 향후 드론은 유무인 복합체계의 구축을 위해 전력지원체계 분야를 비롯해 다방면에 활용될 것임. 드론의 미래 운용개념은 공통 하드웨어 플랫폼을 기반으로 임무에 따라 "}],"tasks":[{"id":"T-CY-69-3","why":"무기체계 사이버위험 관리 단계의 검증 필요성과 연계","desc":"[국방기술기획서·사이버·네트워크] 무기체계 사이버보안 > 69-3 K-RMF 검증 기술: 무기체계 및 방산 정보체계의 생명주기에 따른 사이버위험 관리를 위하여 보안등급 선정⸱통제항목, 선정⸱개발계획, 수립⸱평가의 각 단계를 지원 및 검증하기 위한 기술"}]},"n":15,"total":15,"at":"2026-11-18 12:12","final":false,"created":"2026-11-17 03:58","updated":"2026-11-18 12:13"}
